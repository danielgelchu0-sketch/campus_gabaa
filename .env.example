# Campus Gabaa Environment Configuration Template
# Copy this file to .env for local development

# Set to False in production
DEBUG=True

# Django secret key (generate a long random string for production)
SECRET_KEY=django-insecure-campus-gabaa-capstone-dev-key-change-in-prod-xyz123

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.koyeb.app

# Comma-separated list of trusted origins for CSRF protection in production
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.koyeb.app

# Database URL (leave empty to use local SQLite, or provide PostgreSQL connection string)
# Example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# Stale price threshold in days (listings not updated within this timeframe are flagged stale)
PRICE_STALE_DAYS=7
