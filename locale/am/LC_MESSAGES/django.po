msgstr ""

#: templates/core/about.html:115
msgid ""
"ACID compliant relational storage with dual-mode fallback via dj-database-"
"url."
msgstr ""

#: templates/core/about.html:118
msgid "Static Assets"
msgstr ""

#: templates/core/about.html:120
msgid ""
"Serves compressed static CSS/JS directly from Gunicorn without needing an "
"expensive dedicated CDN or reverse proxy."
msgstr ""

#: templates/core/about.html:123
msgid "Production Server"
msgstr ""

#: templates/core/about.html:125
msgid ""
"Standard UNIX pre-fork worker model for concurrency and instant container "
